    grid-column: auto;
  }

  .hero-carousel__arrow {
    width: 2.45rem;
    height: 2.45rem;
  }

  .hero-carousel__arrow--previous {
    left: 0.45rem;
  }

  .hero-carousel__arrow--next {
    right: 0.45rem;
  }

  .hero-carousel__arrow-icon {
    width: 1.15rem;
    height: 1.15rem;
  }

  .hero-carousel__dots {
    bottom: 0.75rem;

    gap: 0.45rem;
  }

  .hero-carousel__dot {
    width: 0.62rem;
    height: 0.62rem;
  }
}

/* =========================================================
   Very small phones
   ========================================================= */

@media (max-width: 420px) {
  .hero-carousel {
    min-height: 760px;
  }

  .hero-carousel__partnership-layout {
    padding: 4.5rem 3.15rem 3.2rem;
  }

  .hero-carousel__partnership-heading .hero-carousel__eyebrow {
    display: none;
  }

  .hero-carousel__partnership-heading {
    margin-bottom: 0.65rem;
  }

  .hero-carousel__title--partnership {
    font-size: 1.3rem;
  }
}

/* =========================================================
   Short laptop screens
   ========================================================= */

@media (max-height: 700px) and (min-width: 1024px) {
  .hero-carousel__partnership-layout {
    padding-top: 4.75rem;
    padding-bottom: 3.5rem;
  }

  .hero-carousel__partnership-heading {
    margin-bottom: 1rem;
  }

  .hero-carousel__partnership-heading .hero-carousel__eyebrow {
    margin-bottom: 0.65rem;
  }

  .hero-carousel__title--partnership {
    font-size: clamp(1.75rem, 2.9vw, 2.4rem);
  }

  .hero-carousel__business-card {
    min-height: 200px;

    padding: 1rem;
  }

  .hero-carousel__business-card-description,
  .hero-carousel__benefit-list li,
  .hero-carousel__contact-list {
    font-size: 0.74rem;
  }
}

/* =========================================================
   Reduced motion
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  .hero-carousel__slide,
  .hero-carousel__cta,
  .hero-carousel__arrow,
  .hero-carousel__dot {
    transition: none;
  }
}
