    line-height: 1.4;
  }

  .hero-carousel__business-card-description {
    margin-top: 0.45rem;
  }

  .hero-carousel__business-card-footer {
    margin-top: 0.65rem;
    padding-top: 0.55rem;

    font-size: 0.63rem;
  }

  .hero-carousel__heading-icon {
    width: 1.1rem;
    height: 1.1rem;

    flex-basis: 1.1rem;
  }

  .hero-carousel__list-icon {
    width: 0.95rem;
    height: 0.95rem;

    flex-basis: 0.95rem;
  }

  .hero-carousel__contact-icon {
    width: 0.9rem;
    height: 0.9rem;

    flex-basis: 0.9rem;
  }

