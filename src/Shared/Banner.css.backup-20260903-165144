.hero-carousel,
.hero-carousel * {
  box-sizing: border-box;
}

.hero-carousel {
  position: relative;
  isolation: isolate;

  width: 100%;
  height: 100vh;
  min-height: 620px;

  overflow: hidden;

  background: #070a13;
  color: #fff;

  font-family: Nunito, sans-serif;
}

@supports (height: 100svh) {
  .hero-carousel {
    height: 100svh;
  }
}

/* =========================================================
   Slides
   ========================================================= */

.hero-carousel__slides,
.hero-carousel__slide {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;
}

.hero-carousel__slide {
  pointer-events: none;

  visibility: hidden;
  opacity: 0;

  transform: scale(1.015);

  transition:
    opacity 650ms ease,
    visibility 650ms ease,
    transform 7s ease;
}

.hero-carousel__slide--active {
  z-index: 1;

  pointer-events: auto;

  visibility: visible;
  opacity: 1;

  transform: scale(1);
}

.hero-carousel__image {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;
}

.hero-carousel__overlay {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(3, 5, 10, 0.78) 0%,
      rgba(3, 5, 10, 0.48) 52%,
      rgba(3, 5, 10, 0.68) 100%
    ),
    linear-gradient(
      180deg,
      rgba(3, 5, 10, 0.16) 0%,
      rgba(3, 5, 10, 0.42) 55%,
      rgba(3, 5, 10, 0.82) 100%
    );
}

/* =========================================================
   Standard slides
   ========================================================= */

.hero-carousel__content {
  position: absolute;
  z-index: 2;

  top: 50%;
  left: 50%;

  width: min(760px, calc(100% - 150px));

  transform: translate(-50%, -46%);

  text-align: center;
}

.hero-carousel__eyebrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 0.55rem;

  margin-bottom: 1.25rem;
  padding: 0.42rem 0.85rem;

  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 999px;

  background: rgba(10, 13, 18, 0.58);

  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.24);

  color: rgba(255, 255, 255, 0.92);

  font-size: 0.74rem;
  font-weight: 800;
  letter-spacing: 0.09em;
  line-height: 1;
}

.hero-carousel__eyebrow-dot {
  width: 0.55rem;
  height: 0.55rem;

  flex: 0 0 auto;

  border-radius: 50%;

  background: #10b981;

  box-shadow: 0 0 0 5px rgba(16, 185, 129, 0.12);
}

.hero-carousel__title {
  margin: 0;

  color: #fff;

  font-size: clamp(2rem, 4vw, 3.45rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.025em;

  text-wrap: balance;

  text-shadow: 0 3px 24px rgba(0, 0, 0, 0.38);
}

.hero-carousel__description {
  max-width: 700px;

  margin: 1.25rem auto 0;

  color: rgba(255, 255, 255, 0.82);

  font-size: clamp(1rem, 1.55vw, 1.22rem);
  line-height: 1.55;

  text-wrap: pretty;

  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.5);
}

.hero-carousel__cta {
  display: inline-flex;
  align-items: center;

  gap: 0.6rem;

  margin-top: 1.7rem;
  padding: 0.75rem 0.2rem;

  border-bottom: 1px solid rgba(255, 255, 255, 0.78);

  color: #fff;

  font-size: 0.95rem;
  font-weight: 800;

  transition:
    gap 180ms ease,
    color 180ms ease,
    border-color 180ms ease;
}

.hero-carousel__cta:hover,
.hero-carousel__cta:focus-visible {
  gap: 0.9rem;

  border-color: #34d399;

  color: #d1fae5;

  outline: none;
}

/* =========================================================
   Partnership layout - desktop
   ========================================================= */

.hero-carousel__partnership-layout {
  position: absolute;
  z-index: 2;

  inset: 0;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  width: 100%;

  padding: clamp(5.5rem, 9vh, 7rem) clamp(5rem, 9vw, 9rem)
    clamp(4.25rem, 7vh, 5.5rem);
}

.hero-carousel__partnership-heading {
  width: 100%;
  max-width: 950px;

  margin: 0 auto 3.5rem;

  text-align: center;
}

.hero-carousel__partnership-heading .hero-carousel__eyebrow {
  margin-bottom: 1.5rem;
}

.hero-carousel__title--partnership {
  max-width: 950px;

  margin-inline: auto;

  font-size: clamp(2rem, 3.2vw, 3.25rem);
}

/* =========================================================
   Partnership cards
   ========================================================= */

.hero-carousel__business-cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: stretch;

  width: min(100%, 1280px);

  gap: clamp(1rem, 1.7vw, 1.5rem);

  margin-inline: auto;
}

.hero-carousel__business-card {
  min-width: 0;
  min-height: 238px;

  display: flex;
  flex-direction: column;

  padding: clamp(1.2rem, 1.8vw, 1.55rem);

  border: 1px solid rgba(255, 255, 255, 0.78);

  border-radius: 1rem;

  background: rgba(31, 34, 52, 0.9);

  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.24);

  color: #fff;

  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
}

.hero-carousel__card-main-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  width: 2.25rem;
  height: 2.25rem;

  margin-bottom: 1rem;

  border-radius: 0.7rem;

  background: rgba(16, 185, 129, 0.14);

  color: #34d399;
}

.hero-carousel__card-main-icon svg {
  width: 1.25rem;
  height: 1.25rem;
}

.hero-carousel__business-card-title {
  margin: 0;

  color: #fff;

  font-size: clamp(1.05rem, 1.4vw, 1.25rem);
  font-weight: 800;
  line-height: 1.3;
}

.hero-carousel__business-card-description {
  margin: 0.75rem 0 0;

  color: rgba(255, 255, 255, 0.76);

  font-size: clamp(0.8rem, 1vw, 0.92rem);
  line-height: 1.55;
}

.hero-carousel__business-card-footer {
  margin-top: auto;
  padding-top: 0.9rem;

  border-top: 1px solid rgba(255, 255, 255, 0.13);

  color: rgba(255, 255, 255, 0.7);

  font-size: 0.76rem;
  line-height: 1.4;
}

.hero-carousel__business-card-heading {
  display: flex;
  align-items: center;

  gap: 0.7rem;

  margin: 0 0 1.15rem;

  color: #fff;

  font-size: clamp(1.05rem, 1.4vw, 1.25rem);
  font-weight: 800;
  line-height: 1.3;
}

.hero-carousel__business-card-heading > span {
  color: #fff;
}

/* =========================================================
   Icons
   ========================================================= */

.hero-carousel__heading-icon {
  width: 1.45rem;
  height: 1.45rem;

  flex: 0 0 1.45rem;
}

.hero-carousel__list-icon {
  width: 1.15rem;
  height: 1.15rem;

  flex: 0 0 1.15rem;

  margin-top: 0.12rem;
}

.hero-carousel__contact-icon {
  width: 1.05rem;
  height: 1.05rem;

  flex: 0 0 1.05rem;

  margin-top: 0.16rem;
}

.hero-carousel__icon--amber {
  color: #facc15;
}

.hero-carousel__icon--emerald {
  color: #34d399;
}

.hero-carousel__icon--green {
  color: #4ade80;
}

.hero-carousel__icon--blue {
  color: #38a8ff;
}

.hero-carousel__icon--rose {
  color: #fb7185;
}

/* =========================================================
   Why choose us
   ========================================================= */

.hero-carousel__benefit-list {
  display: grid;
  grid-template-columns: 1fr;

  gap: 0.9rem;

  margin: 0;
  padding: 0;

  list-style: none;
}

.hero-carousel__benefit-list li {
  min-width: 0;

  display: flex;
  align-items: flex-start;

  gap: 0.75rem;

  color: rgba(255, 255, 255, 0.8);

  font-size: clamp(0.8rem, 1vw, 0.9rem);
  line-height: 1.5;
}

.hero-carousel__benefit-list strong {
  color: #fff;

  font-weight: 800;
}

/* =========================================================
   Contact
   ========================================================= */

.hero-carousel__contact-list {
  display: grid;
  grid-template-columns: 1fr;

  gap: 0.85rem;

  color: rgba(255, 255, 255, 0.8);

  font-size: clamp(0.8rem, 1vw, 0.9rem);
  line-height: 1.5;
}

.hero-carousel__contact-item {
  min-width: 0;

  display: flex;
  align-items: flex-start;

  gap: 0.7rem;
}

.hero-carousel__contact-values {
  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 0.2rem;
}

.hero-carousel__contact-item a {
  min-width: 0;

  color: rgba(255, 255, 255, 0.82);

  overflow-wrap: anywhere;

  text-decoration: underline;
  text-decoration-color: rgba(255, 255, 255, 0.4);
  text-underline-offset: 3px;

  transition: color 180ms ease;
}

.hero-carousel__contact-item a:hover,
.hero-carousel__contact-item a:focus-visible {
  color: #fff;

  outline: none;
}

/* =========================================================
   Navigation
   ========================================================= */

.hero-carousel__arrow {
  position: absolute;
  z-index: 4;

  top: 50%;

  display: grid;

  width: 3.15rem;
  height: 3.15rem;

  place-items: center;

  transform: translateY(-50%);

  border: 1px solid rgba(255, 255, 255, 0.13);

  border-radius: 50%;

  background: rgba(31, 36, 46, 0.68);

  color: #fff;

  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);

  transition:
    background 180ms ease,
    transform 180ms ease,
    border-color 180ms ease;
}

.hero-carousel__arrow:hover,
.hero-carousel__arrow:focus-visible {
  transform: translateY(-50%) scale(1.06);

  border-color: rgba(255, 255, 255, 0.38);

  background: rgba(41, 48, 61, 0.92);

  outline: none;
}

.hero-carousel__arrow--previous {
  left: 1.15rem;
}

.hero-carousel__arrow--next {
  right: 1.15rem;
}

.hero-carousel__arrow-icon {
  width: 1.45rem;
  height: 1.45rem;
}

.hero-carousel__dots {
  position: absolute;
  z-index: 4;

  bottom: 1.2rem;
  left: 50%;

  display: flex;
  align-items: center;

  gap: 0.55rem;

  transform: translateX(-50%);
}

.hero-carousel__dot {
  width: 0.72rem;
  height: 0.72rem;

  padding: 0;

  border: 0;
  border-radius: 50%;

  background: rgba(255, 255, 255, 0.52);

  transition:
    background 180ms ease,
    transform 180ms ease;
}

.hero-carousel__dot:hover,
.hero-carousel__dot:focus-visible {
  background: rgba(255, 255, 255, 0.82);

  outline: 2px solid rgba(255, 255, 255, 0.5);

  outline-offset: 3px;
}

.hero-carousel__dot--active {
  transform: scale(1.08);

  background: #fff;
}

/* =========================================================
   Large desktop
   ========================================================= */

@media (min-width: 1440px) {
  .hero-carousel__partnership-layout {
    padding-inline: clamp(7rem, 10vw, 11rem);
  }

  .hero-carousel__business-cards {
    max-width: 1320px;
  }

  .hero-carousel__business-card {
    min-height: 260px;
    padding: 1.7rem;
  }

  .hero-carousel__business-card-title,
  .hero-carousel__business-card-heading {
    font-size: 1.3rem;
  }

  .hero-carousel__business-card-description,
  .hero-carousel__benefit-list li,
  .hero-carousel__contact-list {
    font-size: 0.96rem;
  }
}

/* =========================================================
   Laptop: 1024px - 1279px
   ========================================================= */

@media (min-width: 1024px) and (max-width: 1279px) {
  .hero-carousel__partnership-heading {
    max-width: 760px;
    margin-bottom: 3rem;
  }

  .hero-carousel__partnership-heading .hero-carousel__eyebrow {
    margin-bottom: 1.25rem;
  }

  .hero-carousel__partnership-layout {
    padding: 5.75rem 4.8rem 4.25rem;
  }

  .hero-carousel__title--partnership {
    font-size: clamp(1.9rem, 3.5vw, 2.6rem);
  }

  .hero-carousel__business-cards {
    width: min(100%, 1040px);

    gap: 1rem;
  }

  .hero-carousel__business-card {
    min-height: 220px;

    padding: 1.15rem;
  }

  .hero-carousel__business-card-title,
  .hero-carousel__business-card-heading {
    font-size: 1rem;
  }

  .hero-carousel__business-card-description,
  .hero-carousel__benefit-list li,
  .hero-carousel__contact-list {
    font-size: 0.78rem;
  }

  .hero-carousel__benefit-list,
  .hero-carousel__contact-list {
    gap: 0.7rem;
  }
}

/* =========================================================
   Tablet: 768px - 1023px

   2 cards centered on row one.
   Contact spans row two.
   ========================================================= */

@media (min-width: 768px) and (max-width: 1023px) {
  .hero-carousel {
    min-height: 720px;
  }

  .hero-carousel__content {
    width: min(680px, calc(100% - 8rem));
  }

  .hero-carousel__partnership-layout {
    padding: 5.5rem 4.75rem 4.2rem;
  }

  .hero-carousel__partnership-heading {
    max-width: 680px;
    margin-bottom: 2.75rem;
  }

  .hero-carousel__partnership-heading .hero-carousel__eyebrow {
    margin-bottom: 1.2rem;
  }

  .hero-carousel__partnership-heading .hero-carousel__eyebrow {
    margin-bottom: 0.75rem;

    font-size: 0.69rem;
  }

  .hero-carousel__title--partnership {
    max-width: 650px;

    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.12;
  }

  .hero-carousel__business-cards {
    width: min(100%, 680px);

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 1rem;
  }

  .hero-carousel__business-card {
    min-height: 0;

    padding: 1.15rem;
  }

  .hero-carousel__business-card--primary,
  .hero-carousel__business-card--benefits {
    min-height: 245px;
  }

  .hero-carousel__business-card--contact {
    grid-column: 1 / -1;

    min-height: 0;
  }

  .hero-carousel__business-card-title,
  .hero-carousel__business-card-heading {
    font-size: 1.03rem;
  }

  .hero-carousel__business-card-description,
  .hero-carousel__benefit-list li,
  .hero-carousel__contact-list {
    font-size: 0.78rem;
  }

  .hero-carousel__business-card-description {
    line-height: 1.5;
  }

  .hero-carousel__business-card-footer {
    font-size: 0.7rem;
  }

  .hero-carousel__benefit-list {
    gap: 0.7rem;
  }

  .hero-carousel__contact-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 0.7rem 1.5rem;
  }

  .hero-carousel__contact-item--address {
    grid-column: 1 / -1;
  }

  .hero-carousel__arrow {
    width: 2.85rem;
    height: 2.85rem;
  }

  .hero-carousel__arrow--previous {
    left: 0.8rem;
  }

  .hero-carousel__arrow--next {
    right: 0.8rem;
  }
}

/* =========================================================
   Small tablet: 641px - 767px
   ========================================================= */

@media (min-width: 641px) and (max-width: 767px) {
  .hero-carousel {
    min-height: 720px;
  }

  .hero-carousel__content {
    width: calc(100% - 7rem);
  }

  .hero-carousel__partnership-layout {
    padding: 5.25rem 4rem 4rem;
  }

  .hero-carousel__partnership-heading {
    max-width: 600px;
    margin-bottom: 2.25rem;
  }

  .hero-carousel__partnership-heading .hero-carousel__eyebrow {
    margin-bottom: 1rem;
  }

  .hero-carousel__partnership-heading .hero-carousel__eyebrow {
    margin-bottom: 0.7rem;

    font-size: 0.65rem;
  }

  .hero-carousel__title--partnership {
    font-size: clamp(1.55rem, 4.5vw, 1.95rem);
  }

  .hero-carousel__business-cards {
    width: min(100%, 600px);

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 0.8rem;
  }

  .hero-carousel__business-card {
    min-height: 0;

    padding: 1rem;
  }

  .hero-carousel__business-card--primary,
  .hero-carousel__business-card--benefits {
    min-height: 235px;
  }

  .hero-carousel__business-card--contact {
    grid-column: 1 / -1;
  }

  .hero-carousel__business-card-title,
  .hero-carousel__business-card-heading {
    font-size: 0.96rem;
  }

  .hero-carousel__business-card-heading {
    margin-bottom: 0.8rem;
  }

  .hero-carousel__business-card-description,
  .hero-carousel__benefit-list li,
  .hero-carousel__contact-list {
    font-size: 0.72rem;
  }

  .hero-carousel__benefit-list {
    gap: 0.6rem;
  }

  .hero-carousel__contact-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 0.6rem 1.2rem;
  }

  .hero-carousel__contact-item--address {
    grid-column: 1 / -1;
  }
}

/* =========================================================
   Mobile: <= 640px
   ========================================================= */

@media (max-width: 640px) {
  .hero-carousel {
    min-height: 740px;
  }

